<?xml version="1.0" encoding="utf-8"?>
<!-- Nessun traffico in chiaro: solo HTTPS, solo certificati di sistema. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system"/>
        </trust-anchors>
    </base-config>
</network-security-config>
